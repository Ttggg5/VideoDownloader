<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout style="@style/SheetHeader">

        <TextView
            style="@style/SheetTitle"
            android:text="@string/menu_history" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearHistory"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clear" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/historyEmpty"
        style="@style/EmptyState"
        android:visibility="gone">

        <ImageView
            style="@style/EmptyStateIcon"
            android:src="@drawable/ic_history" />

        <TextView
            style="@style/EmptyStateText"
            android:text="@string/no_history" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/historyList"
        style="@style/SheetList" />
</LinearLayout>
