<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/ListRow">

    <ImageView
        android:id="@+id/bookmarkFavicon"
        style="@style/ListLeadingFavicon"
        android:contentDescription="@null"
        android:src="@drawable/ic_public" />

    <LinearLayout style="@style/ListText">

        <TextView
            android:id="@+id/bookmarkTitle"
            style="@style/ListTitle" />

        <TextView
            android:id="@+id/bookmarkUrl"
            style="@style/ListSubtitle" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/bookmarkDelete"
        style="@style/ListTrailingButton"
        android:contentDescription="@string/delete"
        android:src="@drawable/ic_close" />
</LinearLayout>
