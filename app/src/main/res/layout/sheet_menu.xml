<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Quick actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/menuNewTab"
                style="@style/MenuTile">

                <ImageView
                    style="@style/MenuTileIcon"
                    android:src="@drawable/ic_add" />

                <TextView
                    style="@style/MenuTileLabel"
                    android:text="@string/menu_new_tab" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/menuBookmarks"
                style="@style/MenuTile">

                <ImageView
                    style="@style/MenuTileIcon"
                    android:src="@drawable/ic_bookmarks" />

                <TextView
                    style="@style/MenuTileLabel"
                    android:text="@string/bookmarks" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/menuHistoryPages"
                style="@style/MenuTile">

                <ImageView
                    style="@style/MenuTileIcon"
                    android:src="@drawable/ic_public" />

                <TextView
                    style="@style/MenuTileLabel"
                    android:text="@string/menu_history_pages" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/menuDownloads"
                style="@style/MenuTile">

                <ImageView
                    style="@style/MenuTileIcon"
                    android:src="@drawable/ic_download" />

                <TextView
                    style="@style/MenuTileLabel"
                    android:text="@string/downloads" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/menuRefresh"
            style="@style/ListRow.Compact"
            android:paddingStart="24dp">

            <ImageView
                style="@style/MenuRowIcon"
                android:src="@drawable/ic_refresh" />

            <TextView
                style="@style/ListTitle"
                android:text="@string/menu_refresh" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuBookmarkAdd"
            style="@style/ListRow.Compact"
            android:paddingStart="24dp">

            <ImageView
                android:id="@+id/menuBookmarkAddIcon"
                style="@style/MenuRowIcon"
                android:src="@drawable/ic_star_border" />

            <TextView
                style="@style/ListTitle"
                android:text="@string/menu_bookmark_add" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuHistory"
            style="@style/ListRow.Compact"
            android:paddingStart="24dp">

            <ImageView
                style="@style/MenuRowIcon"
                android:src="@drawable/ic_history" />

            <TextView
                style="@style/ListTitle"
                android:text="@string/menu_history" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuOptions"
            style="@style/ListRow.Compact"
            android:paddingStart="24dp">

            <ImageView
                style="@style/MenuRowIcon"
                android:src="@drawable/ic_settings" />

            <TextView
                style="@style/ListTitle"
                android:text="@string/menu_options" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
