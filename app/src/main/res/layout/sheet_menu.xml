<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Page actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/menuForward"
                style="@style/MenuIconButton"
                android:contentDescription="@string/forward"
                android:src="@drawable/ic_forward" />

            <ImageButton
                android:id="@+id/menuBookmark"
                style="@style/MenuIconButton"
                android:contentDescription="@string/menu_bookmark_add"
                android:src="@drawable/ic_star_border" />

            <ImageButton
                android:id="@+id/menuShare"
                style="@style/MenuIconButton"
                android:contentDescription="@string/share_page"
                android:src="@drawable/ic_share" />

            <ImageButton
                android:id="@+id/menuRefresh"
                style="@style/MenuIconButton"
                android:contentDescription="@string/menu_refresh"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/menuNewTab"
            style="@style/MenuRow">

            <ImageView style="@style/MenuRowIcon" android:src="@drawable/ic_add" />

            <TextView style="@style/ListTitle" android:text="@string/menu_new_tab" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuNewIncognito"
            style="@style/MenuRow">

            <ImageView style="@style/MenuRowIcon" android:src="@drawable/ic_incognito" />

            <TextView style="@style/ListTitle" android:text="@string/new_incognito_tab" />
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp" />

        <LinearLayout
            android:id="@+id/menuLibrary"
            style="@style/MenuRow">

            <ImageView style="@style/MenuRowIcon" android:src="@drawable/ic_bookmarks" />

            <LinearLayout style="@style/ListText">

                <TextView style="@style/ListTitle" android:text="@string/library" />

                <TextView style="@style/ListSubtitle" android:text="@string/library_hint" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuFind"
            style="@style/MenuRow">

            <ImageView style="@style/MenuRowIcon" android:src="@drawable/ic_find_in_page" />

            <TextView style="@style/ListTitle" android:text="@string/find_in_page" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuDesktop"
            style="@style/MenuRow"
            android:paddingEnd="12dp">

            <ImageView style="@style/MenuRowIcon" android:src="@drawable/ic_desktop" />

            <TextView
                style="@style/ListTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/opt_desktop" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/menuDesktopCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuSettings"
            style="@style/MenuRow">

            <ImageView style="@style/MenuRowIcon" android:src="@drawable/ic_settings" />

            <TextView style="@style/ListTitle" android:text="@string/settings" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
