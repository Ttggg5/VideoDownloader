<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/ListRow">

    <ImageView
        android:id="@+id/pageHistoryFavicon"
        style="@style/ListLeadingFavicon"
        android:contentDescription="@null"
        android:src="@drawable/ic_public" />

    <LinearLayout style="@style/ListText">

        <TextView
            android:id="@+id/pageHistoryTitle"
            style="@style/ListTitle" />

        <TextView
            android:id="@+id/pageHistorySubtitle"
            style="@style/ListSubtitle" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/pageHistoryDelete"
        style="@style/ListTrailingButton"
        android:contentDescription="@string/delete"
        android:src="@drawable/ic_close" />
</LinearLayout>
