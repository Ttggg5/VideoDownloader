<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout style="@style/SheetHeader">

        <TextView
            style="@style/SheetTitle"
            android:text="@string/download_progress_title" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/downloadsEmpty"
        style="@style/EmptyState"
        android:visibility="gone">

        <ImageView
            style="@style/EmptyStateIcon"
            android:src="@drawable/ic_download" />

        <TextView
            style="@style/EmptyStateText"
            android:text="@string/no_downloads" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/downloadsList"
        style="@style/SheetList" />
</LinearLayout>
