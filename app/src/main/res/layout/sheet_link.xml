<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- The long-pressed link -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_section_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            style="@style/ListLeadingIcon"
            android:contentDescription="@null"
            android:src="@drawable/ic_public" />

        <TextView
            android:id="@+id/linkUrl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="3"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linkOpenNewTab"
        style="@style/ListRow.Compact"
        android:paddingStart="24dp">

        <ImageView
            style="@style/MenuRowIcon"
            android:src="@drawable/ic_open_in_new" />

        <TextView
            style="@style/ListTitle"
            android:text="@string/open_in_new_tab" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linkCopy"
        style="@style/ListRow.Compact"
        android:paddingStart="24dp">

        <ImageView
            style="@style/MenuRowIcon"
            android:src="@drawable/ic_content_copy" />

        <TextView
            style="@style/ListTitle"
            android:text="@string/copy_link" />
    </LinearLayout>
</LinearLayout>
