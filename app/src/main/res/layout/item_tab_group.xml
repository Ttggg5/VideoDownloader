<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.CardView.Filled"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:stateListAnimator="@animator/press_scale"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
    app:cardCornerRadius="20dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <View
                android:id="@+id/groupDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_group_dot" />

            <TextView
                android:id="@+id/groupName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <TextView
                android:id="@+id/groupCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- 2x2 collage of the group's first four tabs -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/tab_preview_height"
            android:layout_marginHorizontal="4dp"
            android:layout_marginBottom="4dp"
            android:columnCount="2"
            android:rowCount="2">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/groupShot1"
                style="@style/GroupShot" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/groupShot2"
                style="@style/GroupShot" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/groupShot3"
                style="@style/GroupShot" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/groupShot4"
                style="@style/GroupShot" />
        </GridLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
