<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/settings"
        app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/settingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <TextView
                style="@style/OptionSectionHeader"
                android:text="@string/section_general" />

            <LinearLayout style="@style/OptionSection">

                <LinearLayout
                    android:id="@+id/optLanguage"
                    style="@style/OptionRow">

                    <ImageView style="@style/OptionIcon" android:src="@drawable/ic_language" />

                    <LinearLayout style="@style/OptionText">

                        <TextView style="@style/OptionLabel" android:text="@string/menu_language" />

                        <TextView android:id="@+id/optLanguageValue" style="@style/OptionValue" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/optRestore"
                    style="@style/OptionRow">

                    <ImageView style="@style/OptionIcon" android:src="@drawable/ic_tab" />

                    <LinearLayout style="@style/OptionText">

                        <TextView style="@style/OptionLabel" android:text="@string/opt_restore_tabs" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/optRestoreSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/optSearch"
                    style="@style/OptionRow">

                    <ImageView style="@style/OptionIcon" android:src="@drawable/ic_search" />

                    <LinearLayout style="@style/OptionText">

                        <TextView style="@style/OptionLabel" android:text="@string/opt_search_engine" />

                        <TextView android:id="@+id/optSearchValue" style="@style/OptionValue" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/OptionSectionHeader"
                android:text="@string/opt_section_browsing" />

            <LinearLayout style="@style/OptionSection">

                <LinearLayout
                    android:id="@+id/optAdblock"
                    style="@style/OptionRow">

                    <ImageView style="@style/OptionIcon" android:src="@drawable/ic_block" />

                    <LinearLayout style="@style/OptionText">

                        <TextView style="@style/OptionLabel" android:text="@string/menu_adblock" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/optAdblockSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/optDesktop"
                    style="@style/OptionRow">

                    <ImageView style="@style/OptionIcon" android:src="@drawable/ic_desktop" />

                    <LinearLayout style="@style/OptionText">

                        <TextView style="@style/OptionLabel" android:text="@string/opt_desktop_default" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/optDesktopSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/optTextSize"
                    style="@style/OptionRow">

                    <ImageView style="@style/OptionIcon" android:src="@drawable/ic_text_size" />

                    <LinearLayout style="@style/OptionText">

                        <TextView style="@style/OptionLabel" android:text="@string/text_size" />

                        <TextView android:id="@+id/optTextSizeValue" style="@style/OptionValue" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/OptionSectionHeader"
                android:text="@string/downloads" />

            <LinearLayout style="@style/OptionSection">

                <LinearLayout
                    android:id="@+id/optMinSize"
                    style="@style/OptionRow">

                    <ImageView style="@style/OptionIcon" android:src="@drawable/ic_filter" />

                    <LinearLayout style="@style/OptionText">

                        <TextView style="@style/OptionLabel" android:text="@string/opt_min_size" />

                        <TextView android:id="@+id/optMinSizeValue" style="@style/OptionValue" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/optFloating"
                    style="@style/OptionRow">

                    <ImageView style="@style/OptionIcon" android:src="@drawable/ic_download" />

                    <LinearLayout style="@style/OptionText">

                        <TextView style="@style/OptionLabel" android:text="@string/opt_floating_button" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/optFloatingSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/OptionSectionHeader"
                android:text="@string/section_privacy" />

            <LinearLayout style="@style/OptionSection">

                <LinearLayout
                    android:id="@+id/optClearData"
                    style="@style/OptionRow">

                    <ImageView style="@style/OptionIcon" android:src="@drawable/ic_delete" />

                    <LinearLayout style="@style/OptionText">

                        <TextView style="@style/OptionLabel" android:text="@string/opt_clear_data" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/OptionSectionHeader"
                android:text="@string/section_about" />

            <LinearLayout style="@style/OptionSection">

                <LinearLayout
                    android:id="@+id/optUpdates"
                    style="@style/OptionRow">

                    <ImageView style="@style/OptionIcon" android:src="@drawable/ic_refresh" />

                    <LinearLayout style="@style/OptionText">

                        <TextView style="@style/OptionLabel" android:text="@string/opt_updates" />

                        <TextView android:id="@+id/optUpdatesValue" style="@style/OptionValue" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
