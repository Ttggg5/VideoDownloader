<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:paddingVertical="10dp">

    <ImageView
        style="@style/ListLeadingIcon"
        android:contentDescription="@null"
        android:src="@drawable/ic_download" />

    <LinearLayout style="@style/ListText">

        <TextView
            android:id="@+id/downloadTitle"
            style="@style/ListTitle"
            android:ellipsize="middle" />

        <ProgressBar
            android:id="@+id/downloadBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginVertical="6dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_download"
            android:indeterminateTint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/downloadState"
                style="@style/ListSubtitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <TextView
                android:id="@+id/downloadBytes"
                style="@style/ListSubtitle"
                android:layout_width="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="?attr/textAppearanceBodySmall" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnPauseResume"
        style="@style/ListTrailingButton"
        android:contentDescription="@string/pause"
        android:src="@drawable/ic_pause" />

    <ImageButton
        android:id="@+id/btnCancel"
        style="@style/ListTrailingButton"
        android:contentDescription="@string/cancel"
        android:src="@drawable/ic_close" />
</LinearLayout>
