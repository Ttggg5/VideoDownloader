<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:id="@+id/webContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?android:attr/colorBackground" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <include
                android:id="@+id/startPage"
                layout="@layout/view_start_page"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Floating bottom bar (overlays the page, slides away on scroll) -->
        <FrameLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_floating_bar"
            android:elevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="10dp">

                <LinearLayout
                    android:id="@+id/urlPill"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="12dp"
                    android:background="@drawable/bg_urlbar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="4dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp">

                        <ImageView
                            android:id="@+id/urlLeadingIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_search"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <FrameLayout
                            android:id="@+id/dlStatus"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="@string/downloads"
                            android:visibility="gone">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/dlProgress"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                app:indicatorColor="?attr/colorPrimary"
                                app:trackColor="?attr/colorSecondaryContainer"
                                app:indicatorSize="32dp"
                                app:trackThickness="3dp" />

                            <TextView
                                android:id="@+id/dlCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:textColor="?attr/colorPrimary"
                                android:textStyle="bold" />
                        </FrameLayout>
                    </FrameLayout>

                    <EditText
                        android:id="@+id/urlBar"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="6dp"
                        android:hint="@string/search_or_url"
                        android:imeOptions="actionGo"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:selectAllOnFocus="true"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:autofillHints="" />

                    <ImageButton
                        android:id="@+id/btnBookmark"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/menu_bookmark_add"
                        android:src="@drawable/ic_star_border"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp">

                    <ImageButton
                        android:id="@+id/btnBack"
                        style="@style/NavButton"
                        android:contentDescription="@string/back"
                        android:src="@drawable/ic_back" />

                    <ImageButton
                        android:id="@+id/btnForward"
                        style="@style/NavButton"
                        android:contentDescription="@string/forward"
                        android:src="@drawable/ic_forward" />

                    <FrameLayout
                        android:id="@+id/btnTabs"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/tabs">

                        <TextView
                            android:id="@+id/tabCount"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_tab_count"
                            android:gravity="center"
                            android:text="1"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />
                    </FrameLayout>

                    <ImageButton
                        android:id="@+id/btnMenu"
                        style="@style/NavButton"
                        android:contentDescription="@string/menu"
                        android:src="@drawable/ic_more" />
                </LinearLayout>
            </LinearLayout>

            <!-- Page-load progress rides the top edge of the bar -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:max="100"
                android:visibility="gone"
                app:indicatorColor="?attr/colorPrimary"
                app:trackColor="@android:color/transparent"
                app:trackThickness="3dp" />
        </FrameLayout>
    </FrameLayout>

    <!-- Draggable floating download button with a count badge -->
    <FrameLayout
        android:id="@+id/dlFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="@dimen/fab_bottom_offset"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageButton
            android:id="@+id/btnDownloads"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_brand_gradient_oval"
            android:contentDescription="@string/downloads"
            android:elevation="10dp"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:outlineAmbientShadowColor="@color/brand_glow"
            android:outlineSpotShadowColor="@color/brand_glow"
            android:padding="17dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_download"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/downloadBadge"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:minWidth="22dp"
            android:paddingHorizontal="6dp"
            android:background="@drawable/bg_badge"
            android:elevation="16dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnTertiary"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
