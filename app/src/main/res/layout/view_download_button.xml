<?xml version="1.0" encoding="utf-8"?>
<!-- Toolbar download button: count badge for videos found on the page, and a
     progress ring while downloads are running. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:contentDescription="@string/downloads"
    android:focusable="true">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/dlProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        app:indicatorColor="?attr/colorPrimary"
        app:indicatorSize="36dp"
        app:trackColor="?attr/colorSecondaryContainer"
        app:trackThickness="3dp" />

    <ImageView
        android:id="@+id/dlIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:src="@drawable/ic_download"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/downloadBadge"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_gravity="center"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_badge"
        android:gravity="center"
        android:minWidth="18dp"
        android:paddingHorizontal="5dp"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
